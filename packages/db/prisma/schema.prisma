// brewsync 2.0 — Prisma schema
//
// Scope: S1 (Tenant/Outlet, User, Outbox) + S2 (RBAC, TenantMembership,
// BusinessProfile). Product master, orders, inventory arrive in S3+.
//
// Conventions:
//   - Every tenant-owned model carries `tenantId`. The Prisma Client Extension
//     in src/tenant-scope.ts injects the filter; Postgres RLS backs it up.
//     Never write `where: { tenantId }` in a service (standard #1).
//   - Money is BigInt minor units (standard #2). No Float/Decimal for money.
//   - Ledger tables are append-only (standard #3): no balance column anywhere.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & configuration — S1-01, S2-07
// ---------------------------------------------------------------------------

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  slug      String       @unique
  name      String
  status    TenantStatus @default(ACTIVE)
  timezone  String       @default("Asia/Jakarta")
  currency  String       @default("IDR")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  outlets         Outlet[]
  businessProfile BusinessProfile?
  memberships     TenantMembership[]
  roles           Role[]
  userRoles       UserRole[]
  outboxEvents    OutboxEvent[]

  // Master product — S3
  units                 Unit[]
  categories            Category[]
  products              Product[]
  productImages         ProductImage[]
  productVariants       ProductVariant[]
  modifierGroups        ModifierGroup[]
  modifiers             Modifier[]
  productModifierGroups ProductModifierGroup[]
  priceLists            PriceList[]
  priceListItems        PriceListItem[]

  // Order — S4
  orders       Order[]
  orderItems   OrderItem[]
  orderCharges OrderCharge[]

  // Payment — S5
  paymentMethods PaymentMethod[]
  bills          Bill[]
  payments       Payment[]

  // Shift — S5
  shifts        Shift[]
  cashMovements CashMovement[]

  // Sales method — S7
  salesMethods SalesMethod[]

  // Floor plan — S7
  areas  Area[]
  tables Table[]

  // KDS — S7
  stations Station[]

  // Inventory & purchasing — S6
  stockMovements StockMovement[]

  // Recipe / BOM — S6-03
  recipes     Recipe[]
  recipeItems RecipeItem[]

  // Purchasing — S6
  suppliers Supplier[]

  // Purchasing — S6-06
  purchaseOrders     PurchaseOrder[]
  purchaseOrderItems PurchaseOrderItem[]

  // Reservation — S8-01
  reservations Reservation[]

  // Landing page — S9-01
  landingPages    LandingPage[]
  landingSections LandingSection[]

  @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

model Outlet {
  id       String       @id @default(uuid()) @db.Uuid
  tenantId String       @db.Uuid
  code     String
  name     String
  address  String?
  phone    String?
  status   OutletStatus @default(ACTIVE)

  // Design §6.3 / §4.2 — per-outlet fiscal + inventory behaviour. Configuration,
  // not code branches. Rates are basis points (1000 = 10%) so no float appears.
  taxInclusive       Boolean            @default(false)
  taxRateBp          Int                @default(1100)
  serviceChargeRateBp Int               @default(0)
  roundingIncrement  Int                @default(100)
  stockDeductionPoint StockDeductionPoint @default(PAID)
  cashVarianceToleranceMinor BigInt      @default(0)

  // S8-06 — when true, QR-channel orders are auto-sent to the kitchen on
  // placement; when false they land OPEN and a waiter accepts (design §16.2).
  qrAutoAccept Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles    UserRole[]
  outboxEvents OutboxEvent[]
  orders       Order[]
  shifts       Shift[]
  areas        Area[]
  tables       Table[]
  stations     Station[]

  // Inventory & purchasing — S6
  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]

  // Reservation — S8-01
  reservations Reservation[]

  // Landing page — S9-01 (per-outlet page, optional)
  landingPages LandingPage[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("outlets")
}

enum OutletStatus {
  ACTIVE
  INACTIVE
}

/// Design §4.2 — whether stock leaves on SENT (kitchen starts) or PAID (retail).
enum StockDeductionPoint {
  SENT
  PAID
}

/// Design §2.2 — preset + per-feature override. The toggle set that makes one
/// core behave as F&B, Retail, or Service. `features` is JSON validated against
/// FeatureFlags in @brewsync/shared on read and write.
model BusinessProfile {
  id        String          @id @default(uuid()) @db.Uuid
  tenantId  String          @unique @db.Uuid
  preset    BusinessPreset
  features  Json
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

enum BusinessPreset {
  FNB
  RETAIL
  SERVICE
  MIXED
}

// ---------------------------------------------------------------------------
// Identity & access — S1-05, S2-01..S2-06 (design §12, §13)
// ---------------------------------------------------------------------------

/// Global login identity. Deliberately NOT tenant-scoped: one person can belong
/// to several tenants (design §13). Tenant-specific data lives on
/// TenantMembership.
model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String?
  fullName     String
  phone        String?
  avatarUrl    String?
  status       UserStatus @default(INVITED)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships   TenantMembership[]
  userRoles     UserRole[]
  refreshTokens RefreshToken[]

  @@map("users")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

/// Design §13.1 — a user's membership in one tenant. The cashier PIN lives here,
/// not on User: PINs are per-tenant and only meaningful on a shared POS device.
model TenantMembership {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  userId       String           @db.Uuid
  displayName  String?
  pinHash      String?
  employeeCode String?
  status       MembershipStatus @default(ACTIVE)
  joinedAt     DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // A cashier PIN is 4–8 digits, so the keyspace is small enough to brute
  // force. Counting failures per membership and locking out makes that
  // impractical without punishing an honest cashier's typo (S2-06).
  pinFailedAttempts Int       @default(0)
  pinLockedUntil    DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@unique([tenantId, employeeCode])
  @@index([tenantId])
  @@map("tenant_memberships")
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

/// Design §12.2 — system-defined catalog, no tenantId. The backend checks exact
/// keys, so tenants compose these into roles but never invent new ones.
model Permission {
  key         String @id
  domain      String
  description String

  rolePermissions RolePermission[]

  @@index([domain])
  @@map("permissions")
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid
  updatedAt DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model RolePermission {
  roleId        String @db.Uuid
  permissionKey String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
  @@map("role_permissions")
}

/// Design §12.2 — role assignment scoped per outlet. A null outletId means
/// tenant-wide (owner). The same person can be Manager at outlet A and Cashier
/// at outlet B.
model UserRole {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @db.Uuid
  userId   String  @db.Uuid
  roleId   String  @db.Uuid
  outletId String? @db.Uuid

  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  outlet Outlet? @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, roleId, outletId])
  @@index([tenantId, userId])
  @@map("user_roles")
}

/// Refresh token rotation (S1-05). Stored hashed; `revokedAt` set on rotation so
/// a stolen token cannot be replayed after use.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ip        String?

  /// Chains every token descended from one login. Rotation revokes the row it
  /// consumed; if a consumed token is presented again the value has leaked, so
  /// the whole family is revoked rather than just that call (S1-05).
  familyId String @default(uuid()) @db.Uuid

  /// Tenant/outlet the session was scoped to, so rotation can re-mint an access
  /// token with the same context instead of silently demoting the session to
  /// tenant-less (S2-09). Deliberately NOT named `tenantId`: RefreshToken is a
  /// global model (see GLOBAL_MODELS in tenant-scope.ts) and must stay outside
  /// RLS — a login has to be readable before any tenant is known. The `scope`
  /// prefix keeps a future reader from mistaking these for ownership columns.
  /// Null means the session has not selected a tenant yet.
  scopeTenantId String? @db.Uuid
  scopeOutletId String? @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Integration — S1-06 (design §8)
// ---------------------------------------------------------------------------

/// Transactional outbox. Written in the SAME transaction as the business change
/// (standard #4); a worker dispatches later. Payload is a self-contained
/// snapshot so consumers never query back into POS (design §8.2).
model OutboxEvent {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  outletId     String?   @db.Uuid
  type         String
  payload      Json
  occurredAt   DateTime  @default(now())
  dispatchedAt DateTime?
  attempts     Int       @default(0)
  lastError    String?

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet Outlet? @relation(fields: [outletId], references: [id], onDelete: SetNull)

  // Partial index on undispatched rows keeps the worker's poll cheap as the
  // table grows, and makes "stuck event" monitoring (sprint plan §17.3) fast.
  @@index([dispatchedAt, occurredAt])
  @@index([tenantId])
  @@map("outbox_events")
}

/// Consumer-side idempotency ledger (design §8.2). A consumer records the event
/// id it processed; a retried dispatch is then a no-op rather than a double
/// journal entry.
model ProcessedEvent {
  eventId     String   @db.Uuid
  consumer    String
  processedAt DateTime @default(now())

  @@id([eventId, consumer])
  @@map("processed_events")
}

// ---------------------------------------------------------------------------
// Master product — S3-01..S3-05 (design §3)
//
// The organising principle from design §3: separate identity from price from
// composition. Product is the concept, ProductVariant is the sellable SKU that
// owns price/barcode/recipe, PriceList overrides price per context, and
// ModifierGroup carries order-time options.
// ---------------------------------------------------------------------------

/// Design §3.2 — units in two roles that get confused and wreck stock: sell unit
/// ("cup", "pcs") vs stock/recipe unit ("gram", "ml").
///
/// Conversion is expressed against a base unit within one dimension: `factor` is
/// how many base units one of this unit equals, scaled by UNIT_FACTOR_SCALE so no
/// float appears (1 kg = 1000 g → factor 1000 * scale). A unit with
/// `baseUnitId = null` IS the base of its dimension and must have factor = scale.
model Unit {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @db.Uuid
  code       String
  name       String
  dimension  UnitDimension
  /// Null = this unit is the base of its dimension.
  baseUnitId String? @db.Uuid
  /// Scaled integer (see UNIT_FACTOR_SCALE in @brewsync/shared). Never a float:
  /// 1 tsp = 4.929 ml would otherwise drift once multiplied through a recipe.
  factor     BigInt  @default(1000000)
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  baseUnit     Unit?            @relation("UnitBase", fields: [baseUnitId], references: [id], onDelete: Restrict)
  derivedUnits Unit[]           @relation("UnitBase")
  sellVariants ProductVariant[] @relation("VariantSellUnit")
  stockVariants ProductVariant[] @relation("VariantStockUnit")
  recipeItems  RecipeItem[]     @relation("RecipeItemUnit")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([baseUnitId])
  @@map("units")
}

/// Dimensions a unit can measure. Conversion is only legal within one dimension
/// — grams to millilitres needs a density, which is a per-ingredient fact and
/// deliberately out of scope here (design §3.2).
enum UnitDimension {
  COUNT
  WEIGHT
  VOLUME
  LENGTH
  TIME
}

/// Design §3.1 — nested via self-reference. Not merely menu tidiness: a category
/// carries *defaults* that flow down to its products (KDS station route, tax
/// rate, report grouping). Set once, inherited by everything beneath.
model Category {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @db.Uuid
  parentId String? @db.Uuid
  name     String
  /// Stable slug for report grouping — survives a rename, unlike `name`.
  slug     String
  sortOrder Int    @default(0)
  isActive Boolean @default(true)

  /// Defaults inherited by products in this category. Null = inherit from the
  /// parent category, then fall back to the outlet setting. Resolved in one
  /// place (category.service) so the precedence rule cannot drift.
  defaultTaxRateBp Int?
  /// KDS routing hint. Station lands in S7; kept as a plain uuid until then so
  /// this column does not need a second migration.
  defaultStationId String? @db.Uuid
  reportGroup      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent         Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       Category[] @relation("CategoryTree")
  products       Product[]
  defaultStation Station?   @relation(fields: [defaultStationId], references: [id], onDelete: SetNull)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([parentId])
  @@index([defaultStationId])
  @@map("categories")
}

/// Design §3.1 — the concept a customer sees ("Kopi Susu", "Cukur Rambut"). Not
/// necessarily sellable on its own: it is a container for variants.
/// `fulfillmentType` sits here as the default and may be overridden per variant.
model Product {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @db.Uuid
  categoryId String? @db.Uuid
  name       String
  /// Tenant-unique handle used by imports and the public catalog URL.
  slug        String
  description String?

  /// Design §2.1 — the single data point that decides whether an item needs
  /// stock, a recipe, KDS routing, or a time slot. Never branch on a vertical
  /// name; read this instead.
  fulfillmentType FulfillmentType @default(STOCKED)

  isActive Boolean @default(true)
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category       Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants       ProductVariant[]
  modifierGroups ProductModifierGroup[]
  images         ProductImage[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([categoryId])
  @@map("products")
}

/// Multi-image for a product (design §16.1 lists a photo in the catalog showcase
/// but does not model it; a child table is the choice recorded here).
///
/// A child table rather than a JSON array so ordering, alt text and the cover
/// flag are columns — queryable, indexable, and individually updatable without
/// rewriting the whole set.
///
/// Scope: Product only. Per-variant images are deliberately not modelled yet —
/// nothing in the design doc asks for them, and adding a nullable `variantId`
/// later is an additive migration. Do not work around this by encoding a variant
/// into `alt`.
model ProductImage {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @db.Uuid
  productId String @db.Uuid

  /// Storage-agnostic URL. Upload/object storage is out of scope for S3 — the
  /// API takes a URL the caller already has. When storage lands, this column
  /// keeps working and gains siblings (bucket key, width/height) beside it.
  url String
  /// Accessibility text. Not derived from the product name: the catalog is
  /// public and an image often shows something the name does not say.
  alt String?

  /// Explicit, not "row 0 is the cover". Insertion order is not a promise
  /// Postgres makes, and reordering images must not silently move the cover.
  /// Exactly one cover per product, enforced in product.service (same shape as
  /// ProductVariant.isDefault) — a partial unique index would be invisible to
  /// Prisma and show up as schema drift.
  isCover   Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productId])
  @@map("product_images")
}

/// Design §2.1 — STOCKED needs stock, MADE_TO_ORDER needs a recipe + KDS route,
/// SERVICE needs a time slot and assigned staff. This enum is what makes the
/// single core change shape without branching on vertical.
enum FulfillmentType {
  STOCKED
  MADE_TO_ORDER
  SERVICE
}

/// Design §3.1 — the real SKU. Price, barcode, and (from S6) recipe live HERE,
/// not on Product. A product with no meaningful variation still gets exactly one
/// default variant so nothing downstream needs a special case.
model ProductVariant {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @db.Uuid
  productId String @db.Uuid

  sku     String
  name    String
  barcode String?

  /// Fallback price in minor units (standard #2). PriceList overrides this per
  /// outlet/sales-method context; see design §3.3.
  basePrice BigInt @default(0)

  /// Overrides Product.fulfillmentType when set — a product may mix, e.g. a
  /// brewed drink (MADE_TO_ORDER) and a bagged-bean variant (STOCKED).
  fulfillmentType FulfillmentType?

  /// Design §3.2 — the unit this variant is *sold* in, and the unit it is
  /// *stocked/consumed* in. Both optional: a SERVICE variant has neither.
  sellUnitId  String? @db.Uuid
  stockUnitId String? @db.Uuid

  /// For SERVICE variants (design §2.1) — how long one booking occupies a slot.
  serviceDurationMin Int?

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellUnit   Unit?           @relation("VariantSellUnit", fields: [sellUnitId], references: [id], onDelete: Restrict)
  stockUnit  Unit?           @relation("VariantStockUnit", fields: [stockUnitId], references: [id], onDelete: Restrict)
  priceItems PriceListItem[]
  orderItems OrderItem[]

  // Inventory & purchasing — S6. A variant is consumed (SALE_CONSUMPTION),
  // received (PURCHASE), and used as a recipe component in these roles.
  stockMovements StockMovement[]

  // Recipe / BOM — S6-03. A variant optionally OWNS one recipe (the finished
  // item it produces) and may appear as a COMPONENT in many others.
  recipe          Recipe?      @relation("VariantRecipe")
  recipeUsages    RecipeItem[] @relation("VariantRecipeComponent")

  // Purchasing — S6-06. A variant is a line on many purchase orders.
  purchaseOrderItems PurchaseOrderItem[]

  @@unique([tenantId, sku])
  // Barcode lookup is the retail scan path — must be unique per tenant to be
  // usable as a lookup key at all (features.barcode).
  @@unique([tenantId, barcode])
  @@index([tenantId])
  @@index([productId])
  @@map("product_variants")
}

/// Design §3.1 — order-time options, NOT separate SKUs. A group is the question
/// ("Sugar level"), a Modifier is an answer ("Less sugar").
/// Gated by `features.modifiers`.
model ModifierGroup {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @db.Uuid
  name     String

  /// Selection rules, validated when an order item is built (S4).
  minSelect Int     @default(0)
  maxSelect Int?
  isRequired Boolean @default(false)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  modifiers Modifier[]
  products  ProductModifierGroup[]

  @@index([tenantId])
  @@map("modifier_groups")
}

/// Design §3.1 — one option. `priceDelta` adjusts price (may be negative);
/// `recipeDelta` (S6) adjusts ingredient consumption, which is how "Less Sugar"
/// costs the same but consumes less.
model Modifier {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  groupId  String @db.Uuid
  name     String

  /// Signed minor units (standard #2) — negative is a legitimate discount-style
  /// option, so this is deliberately not unsigned.
  priceDelta BigInt @default(0)

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group  ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([groupId])
  @@map("modifiers")
}

/// Explicit join for Product ↔ ModifierGroup (design §3.1 "boleh pakai").
/// Explicit rather than implicit m2m so it can carry `sortOrder` and, later,
/// per-product overrides of the group's selection rules.
model ProductModifierGroup {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @db.Uuid
  productId String @db.Uuid
  groupId   String @db.Uuid
  sortOrder Int    @default(0)

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  group   ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([productId, groupId])
  @@index([tenantId])
  @@index([groupId])
  @@map("product_modifier_groups")
}

/// Design §3.3 — price per context. A list may target one outlet, one sales
/// method, both, or neither (tenant-wide). Resolution order and the basePrice
/// fallback live in price.service so there is one implementation.
///
/// `salesMethod` is a plain string until SalesMethod arrives in S7; the resolver
/// compares it case-sensitively against Order.salesMethod.
model PriceList {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @db.Uuid
  name     String
  /// Null = applies to every outlet.
  outletId String? @db.Uuid
  /// Null = applies to every sales method.
  salesMethod String?

  /// Higher wins when two lists match the same context. Explicit so the
  /// tie-break is data, not row order.
  priority Int @default(0)

  validFrom DateTime?
  validTo   DateTime?
  isActive  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  PriceListItem[]

  @@index([tenantId])
  @@index([outletId])
  @@map("price_lists")
}

/// One variant's price inside a list. Absence means "no override" — the resolver
/// falls back to ProductVariant.basePrice (design §3.3).
model PriceListItem {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @db.Uuid
  priceListId String @db.Uuid
  variantId   String @db.Uuid
  /// Minor units (standard #2).
  price       BigInt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  priceList PriceList      @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([priceListId, variantId])
  @@index([tenantId])
  @@index([variantId])
  @@map("price_list_items")
}

// ── Order — S4 ──────────────────────────────────────────────────────────────

/// Design §6 — the order lifecycle. Transitions are validated in one place
/// (order.state.ts, standard #6); an illegal transition throws. `channel` is
/// origin metadata only — QR and online orders run the same machine, pipeline,
/// and events as staff orders (they do not fork the flow).
enum OrderStatus {
  OPEN
  SENT
  SERVED
  BILLED
  PAID
  CLOSED
  VOID
}

enum OrderChannel {
  STAFF
  QR_TABLE
  ONLINE
}

/// Design §6.2 — each non-item component of the bill is one row, so receipts and
/// tax reports aggregate rows instead of recomputing. `amount` is signed minor
/// units (discounts negative). Ordering is fixed (§6): discount → service charge
/// → tax → rounding → gratuity; `sortOrder` freezes that sequence as data.
enum OrderChargeKind {
  DISCOUNT
  SERVICE_CHARGE
  TAX
  ROUNDING
  GRATUITY
}

// ---------------------------------------------------------------------------
// Sales method — S7-01 (design §6)
// ---------------------------------------------------------------------------

/// Design §6 — how the order is fulfilled. Tenant-owned config, referenced by
/// `Order.salesMethod` / `PriceList.salesMethod` as a plain `code` string (not a
/// FK), so a historical order keeps its method even if this row is renamed or
/// deactivated — the same seam PriceList already uses.
///
/// The fiscal columns are nullable and NO-OP in S7 (standard #2 stays intact):
/// tax and service charge still resolve from Outlet (+ Category.defaultTaxRateBp).
/// They exist so a per-method override can be wired later without a migration;
/// until then order.fiscal.ts is an identity passthrough.
model SalesMethod {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  /// Stable identifier orders join on (e.g. "DINE_IN"). Unique per tenant.
  code String
  name String
  kind SalesMethodKind

  /// Reserved fiscal override (§6). Null = inherit the outlet's config. No-op in S7.
  taxRateBp           Int?
  serviceChargeRateBp Int?
  taxInclusive        Boolean?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("sales_methods")
}

enum SalesMethodKind {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

// ---------------------------------------------------------------------------
// Floor plan — S7-02 (design §5.4)
// ---------------------------------------------------------------------------

/// Design §5.4 — the layout hierarchy above tables. Self-referencing: a FLOOR
/// row is a top-level area (parentId null); an AREA row is a section nested under
/// a floor. Retail and service leave `features.tables` off and never create these.
model Area {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  outletId String @db.Uuid
  parentId String? @db.Uuid

  kind      AreaKind
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet   Outlet  @relation(fields: [outletId], references: [id], onDelete: Cascade)
  parent   Area?   @relation("AreaTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Area[]  @relation("AreaTree")
  tables   Table[]

  @@index([tenantId])
  @@index([outletId])
  @@index([parentId])
  @@map("areas")
}

enum AreaKind {
  AREA
  FLOOR
}

/// Design §5.4 — a physical table. One table has at most one active order at a
/// time; the partial unique index `orders_one_per_table` is the hard guard. The
/// status is a small state machine (table.state.ts). `qrToken` is a random token
/// for QR self-service ordering (§16.2), never a guessable table number.
model Table {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @db.Uuid
  outletId String  @db.Uuid
  areaId   String? @db.Uuid

  code     String
  name     String
  status   TableStatus @default(EMPTY)
  capacity Int?
  /// Random token for the QR order URL (§16.2). Unique globally.
  qrToken  String
  sortOrder Int    @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet Outlet  @relation(fields: [outletId], references: [id], onDelete: Cascade)
  area   Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull)
  orders Order[]
  reservations Reservation[]

  @@unique([outletId, code])
  @@unique([qrToken])
  @@index([tenantId])
  @@index([outletId])
  @@index([areaId])
  @@map("tables")
}

enum TableStatus {
  EMPTY
  OCCUPIED
  RESERVED
  DIRTY
}

/// Design §5.5 — a KDS prep station (kitchen, bar, dessert). An outlet owns its
/// stations; a Category routes to one via `defaultStationId`, so a `MADE_TO_ORDER`
/// item lands at the right screen when SENT. Retail/Service outlets simply leave
/// `features.kds` off and never create stations. Pure config + mapping — no
/// vertical branch (§5.5).
model Station {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  outletId String @db.Uuid

  name      String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet     Outlet      @relation(fields: [outletId], references: [id], onDelete: Cascade)
  categories Category[]
  orderItems OrderItem[]

  @@unique([outletId, name])
  @@index([tenantId])
  @@index([outletId])
  @@map("stations")
}

/// Per-item KDS lane (§5.1). Null until the item is routed to a station at SENT;
/// a non-MADE_TO_ORDER item (or a KDS-off outlet) stays null forever. VOID is the
/// per-item cancel from `voidItem`.
enum KdsStatus {
  QUEUED
  PREPARING
  READY
  SERVED
  VOID
}

/// Design §6/§7 — "what was ordered". Bill (BILLED) and Payment (PAID) are
/// separate levels arriving in S5; this model stops at the BILLED snapshot.
model Order {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  outletId String @db.Uuid

  status  OrderStatus  @default(OPEN)
  channel OrderChannel @default(STAFF)

  /// References SalesMethod by `code` (a plain string, not a FK) — the PriceList
  /// seam price.service compares case-sensitively. SalesMethod config landed in S7.
  salesMethod String?

  /// The seated table (§5.4), when `features.tables` is on. Null for takeaway,
  /// delivery, retail, and service. A partial unique index enforces one active
  /// order per table (orders_one_per_table).
  tableId String? @db.Uuid

  /// Standard #7 — item snapshots freeze at SENT; charges freeze at BILLED.
  sentAt   DateTime?
  billedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet  Outlet        @relation(fields: [outletId], references: [id], onDelete: Restrict)
  table   Table?        @relation(fields: [tableId], references: [id], onDelete: Restrict)
  items   OrderItem[]
  charges OrderCharge[]
  bills   Bill[]
  reservation Reservation?

  @@index([tenantId])
  @@index([outletId])
  @@index([tableId])
  @@map("orders")
}

/// One line on the order. Standard #7 — `*Snapshot` columns freeze the price,
/// name, and chosen modifiers at SENT so editing master data afterwards never
/// shifts a historical line. They stay zero/empty/null until then.
model OrderItem {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @db.Uuid
  orderId   String @db.Uuid
  variantId String @db.Uuid

  qty Int

  /// Frozen at SENT via PriceService.resolveMany (standard #7). Minor units.
  priceSnapshot BigInt @default(0)
  nameSnapshot  String @default("")

  /// Sum of chosen modifier price deltas, frozen at SENT. Minor units.
  modifierDeltaSnapshot BigInt @default(0)
  /// Frozen chosen-modifier list for the receipt (name + delta per modifier).
  modifiersSnapshot     Json?

  /// KDS routing (§5.5), resolved at SENT. `stationId` is the station this line
  /// was routed to (from its category's `defaultStationId`); `kdsStatus` is its
  /// prep lane. Both null while OPEN and for items that never enter the KDS
  /// (non-MADE_TO_ORDER, or a `features.kds`-off outlet).
  stationId String?    @db.Uuid
  kdsStatus KdsStatus?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  station Station?       @relation(fields: [stationId], references: [id], onDelete: SetNull)
  charges OrderCharge[]

  @@index([tenantId])
  @@index([orderId])
  @@index([variantId])
  @@index([stationId])
  @@map("order_items")
}

/// Design §6.2 — one persisted component of the bill breakdown. While the order
/// is pre-BILLED these rows are working state: recomputed and rewritten
/// (delete-then-insert) on every mutation. At BILLED they freeze (the Bill
/// snapshot moment, §7.1). `amount` is signed minor units; `basis` is the amount
/// the rate applied to; `rateBp` is basis points (1100 = 11%) or null for
/// flat rows (ROUNDING, fixed discounts).
model OrderCharge {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  orderId  String @db.Uuid

  kind      OrderChargeKind
  label     String
  basis     BigInt
  rateBp    Int?
  amount    BigInt
  taxable   Boolean
  sortOrder Int

  /// Set only for an item-level DISCOUNT (§6.4) — the line it reduces. Null for
  /// order-level discounts and every derived row (service charge, tax, rounding,
  /// gratuity). Lets a delete-then-insert recompute re-target item discounts to
  /// their line rather than losing which line was discounted.
  orderItemId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([orderId])
  @@index([orderItemId])
  @@map("order_charges")
}

// ---------------------------------------------------------------------------
// Payment — S5-01, S5-02 (design §7)
//
// Three distinct levels (§7): Order = "what was ordered", Bill = "what must be
// paid" (created at BILLED, a frozen snapshot of the pipeline total), Payment =
// "how it was paid" (one row per tender). Split payment = many Payment per Bill;
// split bill = many Bill per Order, with the invariant SUM(bill.total) === order
// total after rounding (§7.3). Refund = a negative Payment (§7.4) — append-only,
// never a hard delete, so the cash trail stays intact (standard #3).
// ---------------------------------------------------------------------------

/// Design §7.5 — tender types are data, not code. Adding "GoPay" is a new
/// PaymentMethod row, never a new branch. `kind` is a coarse classifier for
/// reporting/icons; the three booleans drive behaviour (drawer, ref capture,
/// cash reconciliation).
enum PaymentMethodKind {
  CASH
  CARD
  QRIS
  EWALLET
  VOUCHER
  POINTS
  OTHER
}

/// Design §7.5 — a tender a tenant accepts. Per-tenant so each business curates
/// its own list. The flags are what §14 reconciliation and the drawer logic read.
model PaymentMethod {
  id       String            @id @default(uuid()) @db.Uuid
  tenantId String            @db.Uuid
  code     String
  name     String
  kind     PaymentMethodKind @default(OTHER)

  /// Cash-drawer kick on accept (§7.5). Cash and manual-change tenders set this.
  opensCashDrawer Boolean @default(false)
  /// Require a reference number (card approval code, QRIS txn id) at capture.
  needsRefNo      Boolean @default(false)
  /// Contributes to the shift cash drawer (§14.2) — only these create a
  /// CASH_SALE / CASH_REFUND movement. Card/QRIS never touch the drawer.
  countsAsCash    Boolean @default(false)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("payment_methods")
}

/// Design §7.1 — the tagihan snapshot, created when an order reaches BILLED. Its
/// `subtotal`/`total` freeze the pipeline result (§6) so a later master-data edit
/// never shifts a historical bill (standard #7). One order has one Bill in the
/// simple path and several when split (§7.3); `seq` orders them (1-based) and the
/// invariant SUM(total) === order total is enforced at split time and tested.
model Bill {
  id       String     @id @default(uuid()) @db.Uuid
  tenantId String     @db.Uuid
  orderId  String     @db.Uuid
  /// 1-based sequence within the order. A single (non-split) order has seq 1.
  seq      Int        @default(1)
  status   BillStatus @default(OPEN)

  /// Frozen pipeline outputs (minor units, standard #2). `total` is what the
  /// payments must cover for the bill to settle.
  subtotal BigInt
  total    BigInt

  /// Human label for a split share ("Bill 1/3", "Andi"). Null for a single bill.
  label String?

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([orderId, seq])
  @@index([tenantId])
  @@index([orderId])
  @@map("bills")
}

enum BillStatus {
  OPEN
  PAID
  VOID
}

/// Design §7.2 / §7.4 — one tender against a bill. `amount` is signed minor
/// units: positive is a payment, negative is a refund (§7.4). The bill settles
/// when SUM(amount) >= bill.total. `changeGiven` is recorded (not netted into
/// amount) so the tender the customer handed over and the change returned are
/// both auditable. Append-only: a mistaken tender is reversed with another
/// negative row, never deleted (standard #3).
model Payment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  billId   String @db.Uuid
  methodId String @db.Uuid

  amount      BigInt
  /// Cash handed back on an over-tender. Recorded on the settling cash row.
  changeGiven BigInt @default(0)
  /// Reference captured when the method needs one (card/QRIS), else null.
  refNo       String?
  /// Required for a refund (§7.4): why money was returned.
  reason      String?

  /// Membership user who took the tender (audit). Null for system/automated rows.
  createdByUserId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bill   Bill          @relation(fields: [billId], references: [id], onDelete: Cascade)
  method PaymentMethod @relation(fields: [methodId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([billId])
  @@index([methodId])
  @@map("payments")
}

/// Design §14.1 — a cashier's till session. The drawer's cash is a derived
/// balance, never a stored column (standard #3): expectedCash = openingFloat +
/// SUM(CashMovement.amount) for this shift. Open emits `ShiftOpened`, close emits
/// `ShiftClosed` with the reconciliation figures. At most one OPEN shift per
/// (outlet, registerId) at a time — enforced by a partial unique index in the
/// migration (Prisma cannot express "unique WHERE status = OPEN").
model Shift {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @db.Uuid
  outletId   String  @db.Uuid
  /// Physical register/device the drawer belongs to. Null = the outlet's single
  /// drawer. The one-open-shift rule is per (outlet, registerId).
  registerId String?

  openedByUserId String   @db.Uuid
  /// Cash placed in the drawer at open (minor units). Baseline for reconciliation.
  openingFloat   BigInt
  openedAt       DateTime @default(now())

  closedByUserId     String?   @db.Uuid
  /// Physical cash counted at close (minor units). Null until closed.
  closingCountedCash BigInt?
  /// System-derived expected cash at close: openingFloat + SUM(movements).
  expectedCash       BigInt?
  /// closingCountedCash − expectedCash (signed): negative = short, positive = over.
  cashVariance       BigInt?
  closedAt           DateTime?

  status ShiftStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet    Outlet         @relation(fields: [outletId], references: [id], onDelete: Cascade)
  movements CashMovement[]

  @@index([tenantId])
  @@index([outletId])
  @@map("shifts")
}

enum ShiftStatus {
  OPEN
  CLOSED
}

/// Design §14.2 — an append-only cash-drawer ledger row. Never updated or
/// deleted (standard #3); the drawer balance is always SUM over these. A cash
/// tender (`PaymentMethod.countsAsCash`) produces a CASH_SALE; a cash refund a
/// CASH_REFUND. PAID_OUT/DROP are negative; OPENING_FLOAT/PAID_IN positive. The
/// `amount` sign is authoritative — the type is descriptive.
model CashMovement {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  shiftId  String @db.Uuid

  type   CashMovementType
  /// Signed minor units. Sign matches the type (see §14.2 table).
  amount BigInt

  /// Origin of the movement — e.g. ('payment', paymentId) for a CASH_SALE.
  refType String?
  refId   String? @db.Uuid
  /// Required for PAID_IN / PAID_OUT (§14.2): why cash moved.
  reason  String?

  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shift  Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([shiftId])
  @@map("cash_movements")
}

enum CashMovementType {
  OPENING_FLOAT
  CASH_SALE
  CASH_REFUND
  PAID_IN
  PAID_OUT
  DROP
}

// ---------------------------------------------------------------------------
// Inventory & purchasing — S6 (design §4)
//
// Standard #3: stock is an append-only ledger. On-hand is SUM(StockMovement.qty)
// for a variant at an outlet — there is deliberately no stockOnHand column
// (race-updated balances were the root cause of drift in brewsync 1.0, §4).
// An "ingredient" is not a separate entity: it is a ProductVariant in the
// consumed role (ERD §17) — StockMovement and RecipeItem both point at it.
// ---------------------------------------------------------------------------

/// Design §4.1 — the ONLY way stock changes. Each change is one immutable row;
/// on-hand = SUM(qty). `qty` is signed and in SCALED BASE UNITS (the variant's
/// stock-unit base × UNIT_FACTOR_SCALE), so a fractional recipe amount (0.5 g,
/// 30 ml) stays an exact integer through a deep recipe chain — the same
/// float-free trick Unit.factor uses (§3.2). Positive = in, negative = out; the
/// sign is authoritative, the `type` descriptive.
model StockMovement {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @db.Uuid
  outletId  String @db.Uuid
  variantId String @db.Uuid

  type StockMovementType
  /// Signed, scaled base units (see UNIT_FACTOR_SCALE in @brewsync/shared).
  qty  BigInt

  /// Minor units per ONE base unit (standard #2), for moving-average valuation
  /// (§4.3): the real purchase cost on inbound, the moving-average snapshot on a
  /// SALE_CONSUMPTION so historical COGS never shifts. Null when a movement only
  /// corrects quantity (e.g. a stock-take that does not restate cost).
  costPerUnit BigInt?

  /// Origin of the movement — e.g. ('order', orderId), ('po', poId). Lets the
  /// sale path stay idempotent (skip if a row already exists for this order).
  refType String?
  refId   String? @db.Uuid

  /// Required for ADJUSTMENT / WASTE (§4.1): why stock left the automatic path.
  reason String?

  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet  Outlet         @relation(fields: [outletId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([outletId, variantId])
  @@index([refType, refId])
  @@map("stock_movements")
}

/// Design §4.1 — what drove a stock change. The `qty` sign is authoritative; this
/// is the descriptive classifier reports group by.
enum StockMovementType {
  PURCHASE
  SALE_CONSUMPTION
  WASTE
  TRANSFER
  ADJUSTMENT
  PRODUCTION
}

/// Design §3.4 — a recipe / BOM. Optional, one per ProductVariant (the finished
/// item it produces). Gated by `features.recipe`: retail never touches this, a
/// STOCKED item deducts itself directly with no BOM. Explosion to base
/// ingredients is recursive via RecipeItem.componentType (see @brewsync/shared
/// explodeRecipe).
model Recipe {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @db.Uuid
  /// The finished variant this recipe produces. One recipe per variant.
  variantId String @db.Uuid

  /// How many finished base units one full run of this recipe yields, scaled
  /// (UNIT_FACTOR_SCALE). Default one unit; a batch prep ("Simple Syrup") sets a
  /// larger yield so its component quantities are per-batch, not per-unit.
  yieldQtyScaled BigInt @default(1000000)

  notes String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation("VariantRecipe", fields: [variantId], references: [id], onDelete: Cascade)
  items   RecipeItem[]

  /// One recipe per variant — the 1:1 in the ERD (ProductVariant ||--o| Recipe).
  @@unique([variantId])
  @@index([tenantId])
  @@map("recipes")
}

/// Design §3.4 — one component line of a recipe. `componentType` INGREDIENT
/// stops the explosion (a base item); PRODUCT recurses into that variant's own
/// recipe, enabling sub-recipes / prep items. `qtyScaled` is in `recipeUnit`;
/// the service normalises it to the component's stock base units before writing
/// consumption movements.
model RecipeItem {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  recipeId String @db.Uuid

  /// The component consumed — an ingredient variant, or a sub-product variant.
  componentVariantId String            @db.Uuid
  componentType      RecipeComponentType

  /// Quantity of the component per recipe yield, expressed in `recipeUnit`,
  /// scaled (UNIT_FACTOR_SCALE). Kept in the recipe's own unit so editing the
  /// component's stock unit never silently changes the recipe.
  qtyScaled    BigInt
  recipeUnitId String @db.Uuid

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipe           Recipe         @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  componentVariant ProductVariant @relation("VariantRecipeComponent", fields: [componentVariantId], references: [id], onDelete: Restrict)
  recipeUnit       Unit           @relation("RecipeItemUnit", fields: [recipeUnitId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([recipeId])
  @@index([componentVariantId])
  @@map("recipe_items")
}

/// Design §3.4 — whether a recipe component is a base ingredient (stop) or a
/// sub-product (recurse into its recipe).
enum RecipeComponentType {
  INGREDIENT
  PRODUCT
}

// ---------------------------------------------------------------------------
// Supplier — S6-05 (design §4.4)
// ---------------------------------------------------------------------------

/// Design §4.4 — a vendor, tenant-level master data shared across every outlet
/// (a supplier is registered once, not per branch). Carries the fields the
/// purchasing flow and, later, Accounting need: `paymentTermDays` drives the
/// payable due date, `taxId` (NPWP) the input-tax invoice. Per-item buy prices
/// live on PO lines, not here — they change every transaction (§4.4).
model Supplier {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  /// Internal lookup code, unique per tenant.
  code String
  name String

  contactName String?
  phone       String?
  email       String?
  address     String?
  /// NPWP — for the input-tax (faktur pajak masukan) invoice.
  taxId       String?

  /// Payment term in days: 0 = cash, 30 = net-30. Accounting derives the due date.
  paymentTermDays Int    @default(0)
  defaultCurrency String @default("IDR")

  isActive Boolean @default(true)
  notes    String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?  @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // purchaseOrders back-relation added in S6-06 when PurchaseOrder lands.
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("suppliers")
}

/// Design §4.5 — the PO lifecycle. DRAFT is the only editable state; APPROVED is
/// the snapshot moment (standard #7). RECEIVING/RECEIVED/CLOSED are driven by the
/// goods-receipt path (S6-07). CANCELLED is terminal and unreachable once goods
/// start arriving. Mirrored by `purchaseOrderStateMachine` in the API.
enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RECEIVING
  RECEIVED
  CLOSED
  CANCELLED
}

/// Design §4.5 — a purchase order: intent to buy from a supplier. The PO never
/// touches stock; only a goods receipt (S6-07) writes a StockMovement. Money is
/// integer minor units (standard #2); the header totals freeze at APPROVED
/// (standard #7) and are never re-derived from master data after.
model PurchaseOrder {
  id         String              @id @default(uuid()) @db.Uuid
  tenantId   String              @db.Uuid
  outletId   String              @db.Uuid
  supplierId String              @db.Uuid
  /// Human-facing per-tenant number, assigned at create (MAX+1). Unique per tenant.
  poNumber   Int
  status     PurchaseOrderStatus @default(DRAFT)

  expectedDate DateTime?

  /// Snapshotted at APPROVED. Minor units; taxRateBp is basis points (1100 = 11%).
  subtotal  BigInt @default(0)
  taxAmount BigInt @default(0)
  total     BigInt @default(0)
  taxRateBp Int    @default(0)

  notes        String?
  cancelReason String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdByUserId  String?   @db.Uuid
  approvedByUserId String?   @db.Uuid
  approvedAt       DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet   Outlet   @relation(fields: [outletId], references: [id], onDelete: Restrict)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items    PurchaseOrderItem[]

  @@unique([tenantId, poNumber])
  @@index([tenantId])
  @@index([outletId])
  @@index([supplierId])
  @@map("purchase_orders")
}

/// Design §4.5 — a PO line. qty is scaled base units (UNIT_FACTOR_SCALE), unitCost
/// and lineTotal are minor units. unitCost/lineTotal freeze at APPROVED; qtyReceived
/// accumulates as goods arrive (S6-07) — stock itself only ever moves via StockMovement.
model PurchaseOrderItem {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @db.Uuid
  poId      String @db.Uuid
  variantId String @db.Uuid

  qtyOrderedScaled  BigInt
  qtyReceivedScaled BigInt @default(0)
  unitCost          BigInt @default(0)
  lineTotal         BigInt @default(0)
  sortOrder         Int    @default(0)

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  po      PurchaseOrder  @relation(fields: [poId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([poId])
  @@index([variantId])
  @@map("purchase_order_items")
}

// ---------------------------------------------------------------------------
// Reservation — S8-01 (design §15)
// ---------------------------------------------------------------------------

/// Design §15.1 — the booking lifecycle. Mirrored by `reservationStateMachine`
/// in the API. NO_SHOW is reachable only from CONFIRMED; once SEATED the only
/// exit is COMPLETED (the order takes over). CANCELLED/NO_SHOW/COMPLETED are
/// terminal.
enum ReservationStatus {
  REQUESTED
  CONFIRMED
  SEATED
  COMPLETED
  NO_SHOW
  CANCELLED
}

/// Where the booking came from (§15.2). ONLINE originates from the landing page
/// (§17) when both `features.reservation` and `features.landingPage` are on.
enum ReservationSource {
  STAFF
  ONLINE
}

/// Design §15.2 — a reservation. One model, two faces: F&B books a table (+
/// arrival time), Service books a slot + staff (§5.6). What is reserved is data,
/// not a code branch. A deposit rides the ordinary Payment path (§7, standard
/// #2 — minor units); `orderId` is filled at SEATED when the booking hands off
/// to a live Order. Anti double-booking (§15.3) is enforced in the service, not
/// the schema — an overlap check over CONFIRMED rows for the same table/staff.
model Reservation {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  outletId String @db.Uuid

  source ReservationSource @default(STAFF)
  status ReservationStatus @default(REQUESTED)

  customerName  String
  customerPhone String
  customerEmail String?
  partySize     Int

  /// Arrival time (F&B) / slot start (service). `durationMin` estimates table
  /// occupancy or the service slot length — used by the overlap guard (§15.3).
  reservedFor DateTime
  durationMin Int?

  /// The promised table (F&B, optional — may auto-assign at seating) or the
  /// assigned staff/resource (service). Kept nullable; one or the other applies.
  tableId         String? @db.Uuid
  assignedStaffId String? @db.Uuid

  /// Deposit rides the Payment path (§15.3). Minor units (standard #2); the
  /// Payment row it links to lives in the same ledger as every other tender.
  depositAmount    BigInt?
  depositPaymentId String? @db.Uuid

  notes String?

  /// Filled at SEATED — the live Order this booking became (§15.3). 1:1.
  orderId String? @db.Uuid

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdByUserId String?   @db.Uuid
  confirmedAt     DateTime?
  seatedAt        DateTime?

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet Outlet  @relation(fields: [outletId], references: [id], onDelete: Restrict)
  table  Table?  @relation(fields: [tableId], references: [id], onDelete: SetNull)
  order  Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([orderId])
  @@index([tenantId])
  @@index([outletId])
  @@index([tableId])
  // Drives the §15.3 overlap query: CONFIRMED rows for a table in a time window.
  @@index([tableId, status])
  @@index([assignedStaffId, status])
  @@map("reservations")
}

// Landing page & CMS — S9-01 (design §17)

/// A tenant's public landing page (`features.landingPage`). Section-based
/// content the admin edits from the dashboard (§17.1) — one page per tenant (or
/// per outlet). The PUBLIC endpoint only ever serves the `PUBLISHED` version;
/// edits happen on the draft, so half-finished content never leaks. `slug` is
/// resolved unscoped (like `Table.qrToken`) then everything binds to the
/// resolved tenant — no client string ever selects a tenant (standard #1).
model LandingPage {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  /// Null = a per-tenant page; set = a per-outlet page (§17.1).
  outletId String? @db.Uuid

  /// Public path segment (`/p/:slug`). Unique per tenant. No subdomain — the
  /// page is served on the shared host by path, like the QR token route.
  slug        String
  title       String
  description String?

  /// Brand theme (warna, font, logo) as JSON — applied as CSS variables by the
  /// public renderer. Kept opaque here; shape validated at the API boundary.
  theme Json?

  /// Mirrors `features.onlineOrder` for THIS page (§17.1): true = the catalog
  /// can check out (channel=ONLINE, §16.3); false = catalog-only showcase. The
  /// `onlineOrder` feature flag stays the master kill-switch enforced in the
  /// service; this is the per-page preference the admin publishes.
  orderingEnabled Boolean @default(false)

  status      LandingPageStatus @default(DRAFT)
  publishedAt DateTime?

  updatedBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet   Outlet?          @relation(fields: [outletId], references: [id], onDelete: SetNull)
  sections LandingSection[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([outletId])
  @@map("landing_pages")
}

/// One content block on a landing page (§17.1). Heterogeneous by `type`; each
/// type has one renderer + one Zod content schema at the API boundary. `content`
/// is JSON shaped per type (hero headline+CTA, catalog category/product picks,
/// hours rows, …). `position` is admin-ordered and unique per page.
model LandingSection {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @db.Uuid
  landingPageId String @db.Uuid

  type     LandingSectionType
  position Int                @default(0)

  /// Admin-facing label for the section list (not necessarily shown publicly).
  title String?

  /// Per-`type` content. For CATALOG: `{ categoryIds?, productIds? }` — the
  /// admin's live selection from master (§3); prices/availability are resolved
  /// from master at request time, never copied here (§17.1 "gak ada menu basi").
  content Json

  isVisible Boolean @default(true)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  landingPage LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@unique([landingPageId, position])
  @@index([tenantId])
  @@index([landingPageId])
  @@map("landing_sections")
}

enum LandingSectionType {
  HERO
  CATALOG
  ABOUT
  GALLERY
  CONTACT
  HOURS
  MAP
  CUSTOM
}

enum LandingPageStatus {
  DRAFT
  PUBLISHED
}
