{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // The base config sets rootDir to src for emit. Tests and vitest.config.ts
    // sit outside it and are only ever typechecked, never built.
    "rootDir": "."
  },
  "include": ["src/**/*", "tests/**/*", "vitest.config.ts"]
}
