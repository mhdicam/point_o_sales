# S0-06 — copy to `.env` and adjust. Validated by zod at boot (apps/api/src/env.ts);
# the API refuses to start on a bad value rather than failing at first request.

NODE_ENV=development

# --- Database -------------------------------------------------------------
# Two URLs on purpose (S1-04). DATABASE_URL is the *runtime* role: it is NOT a
# superuser and NOT the table owner, so Postgres RLS actually applies to it.
# DIRECT_DATABASE_URL owns the schema and runs migrations/seeds.
# A superuser bypasses RLS silently, which would make the safety net a no-op.
DATABASE_URL=postgresql://brewsync_app:brewsync_app@localhost:5433/brewsync_dev?schema=public
DIRECT_DATABASE_URL=postgresql://brewsync:brewsync@localhost:5433/brewsync_dev?schema=public
# UNSCOPED_DATABASE_URL is the `brewsync_system` role (BYPASSRLS). It is the ONE
# sanctioned cross-tenant / pre-tenant read path: public landing slug + QR table
# resolve, the outbox worker sweep, the login membership list. SELECT-only role;
# it never writes. Distinct from DATABASE_URL, which stays strictly RLS-subject.
UNSCOPED_DATABASE_URL=postgresql://brewsync_system:brewsync_system@localhost:5433/brewsync_dev?schema=public

# Separate database for integration tests — wiped between runs.
TEST_DATABASE_URL=postgresql://brewsync_app:brewsync_app@localhost:5433/brewsync_test?schema=public
TEST_DIRECT_DATABASE_URL=postgresql://brewsync:brewsync@localhost:5433/brewsync_test?schema=public
TEST_UNSCOPED_DATABASE_URL=postgresql://brewsync_system:brewsync_system@localhost:5433/brewsync_test?schema=public

# --- Auth -----------------------------------------------------------------
# Min 32 chars. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-0123456789
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- API ------------------------------------------------------------------
PORT=4000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Outbox ---------------------------------------------------------------
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=50

# --- Onboarding -----------------------------------------------------------
# Optional platform token for tenant provisioning (S2-08). When unset, the
# /onboarding/tenants endpoint is not mounted — tenant creation becomes an
# out-of-band operation (manual SQL or a dedicated admin tool).
# PLATFORM_API_TOKEN=your-secret-platform-token-here
